{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/flow.schema.json",
  "title": "Chaînes d'appels et étapes",
  "type": "object",
  "required": ["version", "flows"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "service", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "service": { "type": "string", "minLength": 2 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["dependency", "policy"],
              "additionalProperties": false,
              "properties": {
                "dependency": { "type": "string", "minLength": 2 },
                "policy": { "type": "string", "minLength": 2 }
              }
            }
          }
        }
      }
    }
  }
}
