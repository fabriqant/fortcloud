{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/objective.schema.json",
  "title": "Objectifs de niveau de service",
  "type": "object",
  "required": ["version", "objectives"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "service", "signal", "kind", "target", "alert_threshold", "window", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "service": { "type": "string", "minLength": 2 },
          "signal": { "type": "string", "minLength": 2 },
          "kind": { "enum": ["availability", "latency", "freshness", "completeness", "validity"] },
          "target": {},
          "alert_threshold": {},
          "window": { "type": "string", "pattern": "^(0|([0-9]+(ms|s|m|h|d))+)$" },
          "owner": { "type": "string", "minLength": 2 },
          "notes": { "type": "string" }
        },
        "oneOf": [
          {
            "properties": {
              "kind": { "enum": ["availability", "completeness", "validity"] },
              "target": { "type": "number", "minimum": 0, "maximum": 100 },
              "alert_threshold": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          {
            "properties": {
              "kind": { "enum": ["latency", "freshness"] },
              "target": { "type": "string", "pattern": "^(0|([0-9]+(ms|s|m|h|d))+)$" },
              "alert_threshold": { "type": "string", "pattern": "^(0|([0-9]+(ms|s|m|h|d))+)$" }
            }
          }
        ]
      }
    }
  }
}
