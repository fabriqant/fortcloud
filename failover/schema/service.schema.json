{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/service.schema.json",
  "title": "Business services and availability objectives",
  "type": "object",
  "required": ["version", "services"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "criticality", "owner", "rto", "rpo", "components"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "description": { "type": "string" },
          "criticality": { "enum": ["P0", "P1", "P2"] },
          "owner": { "type": "string", "minLength": 2 },
          "availability_target": { "type": "string" },
          "rto": { "type": "string", "pattern": "^(0|[0-9]+[smhd]([0-9]+[smhd])*)$" },
          "rpo": { "type": "string", "pattern": "^(0|[0-9]+[smhd]([0-9]+[smhd])*)$" },
          "components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "strategy": { "type": "string" }
        }
      }
    }
  }
}
