{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/secret.schema.json",
  "title": "Inventaire des secrets — références uniquement",
  "type": "object",
  "required": ["version", "secrets"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "secrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "store", "reference", "environments", "owner", "last_rotated", "rotation_days", "used_by"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "store": { "enum": ["vault", "aws-secrets-manager", "azure-key-vault", "gcp-secret-manager", "k8s-secret"] },
          "reference": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9+.-]*://\\S+|\\$\\{[^}]+\\})$"
          },
          "environments": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "owner": { "type": "string", "minLength": 2 },
          "last_rotated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "rotation_days": { "type": "integer", "minimum": 1 },
          "used_by": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
