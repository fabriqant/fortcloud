{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/signal.schema.json",
  "title": "Signaux de santé et de qualité",
  "type": "object",
  "required": ["version", "signals"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "source", "interval", "unit", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "kind": { "enum": ["availability", "latency", "freshness", "completeness", "validity"] },
          "source": { "enum": ["prometheus", "datadog", "cloudwatch", "sql", "custom"] },
          "query": { "type": "string" },
          "interval": { "type": "string", "pattern": "^(0|([0-9]+(ms|s|m|h|d))+)$" },
          "unit": { "enum": ["percent", "ms", "duration"] },
          "owner": { "type": "string", "minLength": 2 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
