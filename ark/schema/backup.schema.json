{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/backup.schema.json",
  "title": "Politiques de sauvegarde",
  "type": "object",
  "required": ["version", "backups"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "backups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "asset", "type", "schedule", "retention_days", "immutable", "cross_region", "encrypted", "last_successful"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "asset": { "type": "string", "minLength": 2 },
          "type": { "enum": ["full", "incremental", "snapshot", "cdc"] },
          "schedule": { "type": "string", "pattern": "^(0|[0-9]+[smhd]([0-9]+[smhd])*)$" },
          "retention_days": { "type": "integer", "minimum": 0 },
          "immutable": { "type": "boolean" },
          "cross_region": { "type": "boolean" },
          "encrypted": { "type": "boolean" },
          "last_successful": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "provider": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
