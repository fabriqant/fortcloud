{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/dependency.schema.json",
  "title": "Dépendances sortantes",
  "type": "object",
  "required": ["version", "dependencies"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "criticality", "operation", "idempotent", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "type": { "enum": ["database", "cache", "http_api", "grpc", "queue", "search"] },
          "criticality": { "enum": ["P0", "P1", "P2"] },
          "operation": { "enum": ["read", "write"] },
          "idempotent": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 2 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
