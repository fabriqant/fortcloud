{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/check.schema.json",
  "title": "Preuves de vérification des SLO",
  "type": "object",
  "required": ["version", "checks"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "objective", "last", "result", "evidence", "owner", "runbook"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "objective": { "type": "string", "minLength": 2 },
          "last": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "result": { "enum": ["passed", "partial", "failed"] },
          "evidence": { "type": "string" },
          "owner": { "type": "string", "minLength": 2 },
          "runbook": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
