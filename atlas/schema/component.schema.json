{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/component.schema.json",
  "title": "Inventaire des composants",
  "type": "object",
  "required": ["version", "components"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "criticality", "owner", "provider", "regions", "redundancy"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "category": {
            "enum": ["storage", "processing", "orchestration", "network", "identity", "external_service"]
          },
          "criticality": { "enum": ["P0", "P1", "P2"] },
          "owner": { "type": "string", "minLength": 2 },
          "provider": { "type": "string", "minLength": 2 },
          "environments": { "type": "array", "items": { "type": "string" } },
          "regions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "zones": { "type": "array", "items": { "type": "string" } },
          "redundancy": {
            "type": "object",
            "required": ["instances", "active_passive", "replication"],
            "additionalProperties": false,
            "properties": {
              "instances": { "type": "integer", "minimum": 1 },
              "active_passive": { "type": "boolean" },
              "replication": { "enum": ["none", "async", "sync", "multi_region"] }
            }
          },
          "backup": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "immutable": { "type": "boolean" },
              "retention_days": { "type": "integer", "minimum": 0 },
              "last_restore_test": { "type": ["string", "null"] }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
