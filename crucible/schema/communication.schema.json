{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/communication.schema.json",
  "title": "Exercise communication plan",
  "type": "object",
  "required": ["version", "channels", "stakeholders", "plan"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "audience", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "type": { "enum": ["slack", "bridge", "email", "pager"] },
          "audience": { "enum": ["internal", "external", "both"] },
          "owner": { "type": "string", "minLength": 2 },
          "approval": { "type": "string", "minLength": 2 }
        }
      }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "channel", "notify"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "channel": { "type": "string", "minLength": 2 },
          "notify": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["start", "update", "end"] }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["updates_every", "escalation", "owner"],
      "additionalProperties": false,
      "properties": {
        "updates_every": { "type": "string", "pattern": "^(0|([0-9]+(ms|s|m|h|d))+)$" },
        "escalation": { "type": "string", "minLength": 2 },
        "go_no_go": { "type": "string", "minLength": 2 },
        "owner": { "type": "string", "minLength": 2 }
      }
    }
  }
}
