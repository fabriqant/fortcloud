{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/environment.schema.json",
  "title": "Environnements de répétition contrôlés",
  "type": "object",
  "required": ["version", "environments"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "isolation", "data", "owner", "approved"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "isolation": { "enum": ["full", "partial", "shared"] },
          "data": { "enum": ["synthetic", "masked", "production"] },
          "owner": { "type": "string", "minLength": 2 },
          "approved": { "type": "boolean" },
          "approved_by": { "type": "string", "minLength": 2 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
