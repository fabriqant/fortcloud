{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/change.schema.json",
  "title": "Pipelines de déploiement contrôlés",
  "type": "object",
  "required": ["version", "pipelines"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "environment", "trigger", "deployer", "owner", "review", "tests", "rollback"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "environment": { "type": "string", "minLength": 2 },
          "trigger": { "enum": ["manual", "pull_request", "tag", "schedule"] },
          "deployer": { "type": "string", "minLength": 2 },
          "owner": { "type": "string", "minLength": 2 },
          "review": {
            "type": "object",
            "required": ["required", "approvers"],
            "additionalProperties": false,
            "properties": {
              "required": { "type": "boolean" },
              "approvers": { "type": "integer", "minimum": 0 }
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["unit", "integration", "security", "contract", "e2e", "load"] }
          },
          "rollback": {
            "type": "object",
            "required": ["enabled"],
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "target": { "type": "string", "minLength": 2 },
              "verified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "automate": { "type": "boolean" }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
