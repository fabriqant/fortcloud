{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/drill.schema.json",
  "title": "Failover drill evidence",
  "type": "object",
  "required": ["version", "drills"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "drills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "strategy", "scenario", "last", "result", "evidence", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "strategy": { "type": "string", "minLength": 2 },
          "scenario": { "enum": ["primary-loss", "region-loss", "network-partition", "idp-outage", "dns-failover", "manual"] },
          "last": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "result": { "enum": ["passed", "partial", "failed"] },
          "duration": { "type": "string", "pattern": "^(0|[0-9]+[smhd]([0-9]+[smhd])*)$" },
          "evidence": { "type": "string", "minLength": 2 },
          "owner": { "type": "string", "minLength": 2 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
