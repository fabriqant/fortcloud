{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/asset.schema.json",
  "title": "Data asset inventory",
  "type": "object",
  "required": ["version", "assets"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "criticality", "classification", "owner", "provider", "region", "encryption_at_rest"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "category": { "enum": ["database", "object_store", "file_share", "queue", "config", "secrets", "log"] },
          "criticality": { "enum": ["P0", "P1", "P2"] },
          "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
          "owner": { "type": "string", "minLength": 2 },
          "provider": { "type": "string", "minLength": 2 },
          "region": { "type": "string", "minLength": 2 },
          "encryption_at_rest": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
