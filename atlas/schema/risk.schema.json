{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/risk.schema.json",
  "title": "FMEA risk register",
  "type": "object",
  "required": ["version", "risks"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "title", "components", "flows", "failure_mode",
          "likelihood", "impact", "status", "owner",
          "mitigations", "action", "target_date"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 3 },
          "components": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "flows": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "failure_mode": { "type": "string", "minLength": 5 },
          "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "status": { "enum": ["open", "in_progress", "mitigated", "accepted", "closed"] },
          "owner": { "type": "string", "minLength": 2 },
          "mitigations": { "type": "array", "items": { "type": "string" } },
          "action": { "type": "string", "minLength": 5 },
          "target_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
