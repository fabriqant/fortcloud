{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/topology.schema.json",
  "title": "Failover topology",
  "type": "object",
  "required": ["version", "topology"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "topology": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "criticality", "owner", "provider", "region", "zone", "role", "pair", "capacity", "health_check"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 2 },
          "criticality": { "enum": ["P0", "P1", "P2"] },
          "owner": { "type": "string", "minLength": 2 },
          "provider": { "type": "string", "minLength": 2 },
          "region": { "type": "string", "minLength": 2 },
          "zone": { "type": "string", "minLength": 2 },
          "role": { "enum": ["primary", "standby", "standalone"] },
          "pair": { "type": ["string", "null"] },
          "capacity": { "type": "integer", "minimum": 1 },
          "health_check": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
