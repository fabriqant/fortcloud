{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience.local/schema/policy.schema.json",
  "title": "Resilience policies",
  "type": "object",
  "required": ["version", "policies"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "dependency", "timeout", "retries", "backoff", "backoff_multiplier",
          "jitter", "circuit_breaker", "failure_threshold", "reset_timeout",
          "bulkhead", "fallback"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "dependency": { "type": "string", "minLength": 2 },
          "timeout": { "type": "string", "pattern": "^(0|([0-9]+(ms|s|m|h|d))+)$" },
          "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
          "backoff": { "type": "string", "pattern": "^(0|([0-9]+(ms|s|m|h|d))+)$" },
          "backoff_multiplier": { "type": "number", "minimum": 1 },
          "jitter": { "type": "boolean" },
          "circuit_breaker": { "type": "boolean" },
          "failure_threshold": { "type": "integer", "minimum": 1 },
          "reset_timeout": { "type": "string", "pattern": "^(0|([0-9]+(ms|s|m|h|d))+)$" },
          "bulkhead": { "type": "string" },
          "fallback": { "enum": ["none", "cached", "default", "degraded", "queue"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
